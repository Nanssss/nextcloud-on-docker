# Don't put slashes at the end of the paths

DOMAIN="ubuntu-server-nans.duckdns.org" # Your domain name, same as the one in your nginx configuration
NEXTCLOUD_DIR="/home/nans/docker/nextcloud" # Path to nextcloud-on-docker root directory
NEXTCLOUD_DATA_DIR="/mnt/toshiba-hdd/nextcloud/data" # Path to your nextcloud data directory
BACKUP_DIR="/mnt/toshiba-hdd/backups" # Path to backup directory

# You can change these if you want to, but the default values will work
WAKEUP_DAY=friday # Day of the week for wakeup
WAKEUP_TIME=03:00 # Time for wakeup
WAKEUP_FILE_SAVE="/var/lib/rtc-wakeup-time" # Path to save the next wakeup time for the RTC wakeup script
RTC_LOG="/var/log/rtc-wakeup.log" # Path to log file for the RTC wakeup script